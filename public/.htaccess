# EMPIRES — static web build (docs/DEPLOY_WEB.md)
# Optional: only used by Apache/LiteSpeed servers (Hostinger shared hosting).
# Purpose: after an update, browsers always fetch the new index.html, while the
# hashed files in assets/ are cached for a long time. Saves live in the browser
# (localStorage) and are NOT affected by any of this.

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

Options -Indexes
